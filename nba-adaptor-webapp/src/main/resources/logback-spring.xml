<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <appender name="json-ecs-log" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="co.elastic.logging.logback.EcsEncoder">
            <serviceName>${ECS_SERVICE_NAME:-nba-adaptor}</serviceName>
            <eventDataset>${ECS_SERVICE_NAME:-nba-adaptor}-application-log</eventDataset>
        </encoder>
    </appender>

    <appender name="console" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <springProfile name="!local &amp; !test">
        <root level="INFO">
            <appender-ref ref="json-ecs-log"/>
        </root>
    </springProfile>

    <springProfile name="local | test">
        <root level="INFO">
            <appender-ref ref="console"/>
        </root>
        <logger name="be.telenet.css.pegacdh.nba" level="DEBUG"/>
    </springProfile>

</configuration>
