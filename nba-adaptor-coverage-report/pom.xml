<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>be.telenet.css.nextbestaction.adaptor</groupId>
        <artifactId>nba-adaptor</artifactId>
        <version>1.3.0-SNAPSHOT</version>
    </parent>

    <artifactId>nba-adaptor-coverage-report</artifactId>
    <packaging>pom</packaging>
    <name>NBA adaptor Coverage Report</name>

    <dependencies>
        <dependency>
            <groupId>be.telenet.css.nextbestaction.adaptor</groupId>
            <artifactId>nba-adaptor-integration-tests</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>be.telenet.css.nextbestaction.adaptor</groupId>
            <artifactId>nba-adaptor-webapp</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <profiles>
        <profile>
            <id>coverage</id>
            <activation/>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>report-aggregate</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>report-aggregate</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
